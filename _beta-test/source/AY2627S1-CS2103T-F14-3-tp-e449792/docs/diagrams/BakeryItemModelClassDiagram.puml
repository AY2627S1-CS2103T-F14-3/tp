@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam nodesep 70

Package Model as ModelPackage <<Rectangle>>{
Class AddressBook
Class ModelManager

package "bakeryitem\n" as BakeryItemPackage {
Class UniqueBakeryItemList
Class BakeryItem
Class BakeryItemName
Class Price
}
}

AddressBook *-down-> "1" UniqueBakeryItemList
UniqueBakeryItemList -down-> "~* all" BakeryItem
ModelManager -left-> "~* filtered" BakeryItem
BakeryItem *-down-> BakeryItemName
BakeryItem *-down-> Price
BakeryItemName -[hidden]right-> Price
@enduml
