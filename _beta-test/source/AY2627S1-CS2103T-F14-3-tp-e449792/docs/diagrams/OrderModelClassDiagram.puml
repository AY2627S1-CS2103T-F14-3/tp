@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam nodesep 70

Package Model as ModelPackage <<Rectangle>>{
Class AddressBook
Class ModelManager
Class Person

package "order\n" as OrderPackage {
Class ClientOrder
Class Quantity
Class Deadline
}

package "bakeryitem\n" as BakeryItemPackage {
Class BakeryItem
}
}

AddressBook -down-> "~* all" ClientOrder
ModelManager -down-> "~* filtered" ClientOrder
ClientOrder *-down-> "1" Quantity
ClientOrder *-down-> "1" Deadline
ClientOrder -down-> "1 client" Person
ClientOrder -down-> "1 item" BakeryItem
AddressBook -[hidden]right-> ModelManager
Person -[hidden]right-> Quantity
Quantity -[hidden]right-> Deadline
Deadline -[hidden]right-> BakeryItem
@enduml
